{
  "name": "excel-validator-addin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npx office-addin-dev-certs install && npx http-server . -p 3000 -c-1 -S -C ~/.office-addin-dev-certs/localhost.crt -K ~/.office-addin-dev-certs/localhost.key",
    "start:web": "npx http-server . -p 3000 -c-1 -S -C ~/.office-addin-dev-certs/localhost.crt -K ~/.office-addin-dev-certs/localhost.key",
    "certs:install": "npx office-addin-dev-certs install",
    "manifest:validate": "npx office-addin-manifest validate manifest.xml",
    "lint": "eslint . --ext .js",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "c8 --include=modules/taskpane/address.js --include=modules/taskpane/errors.js --include=modules/taskpane/scope.js --include=modules/taskpane/exception-helpers.js --include=modules/taskpane/tagged-cells.js --reporter=text --reporter=lcov --reporter=json-summary --check-coverage --lines 75 --functions 70 --branches 65 node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "http-server": "^14.1.1",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-manifest": "^1.13.4"
  }
}
