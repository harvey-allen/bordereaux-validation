aws_region = "eu-west-2"
project_name = "bordereaux"
environment = "free-tier"

# Keep a free-tier friendly shape
instance_type = "t3.micro"
root_volume_size = 20

# Replace with your IP/CIDR for better security, e.g. "203.0.113.10/32"
ssh_allowed_cidr = "0.0.0.0/0"

# Optional existing key pair name in your AWS account
# key_name = "my-keypair"

deploy_smoke_container = true
