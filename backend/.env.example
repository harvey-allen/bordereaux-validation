# Environment selection: development, staging, or production
# This determines which .env.{ENVIRONMENT} file is loaded
# Default: development
ENVIRONMENT=development

# Database Configuration
# For development: Local PostgreSQL on localhost
# For staging/production: AWS RDS endpoint
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bordereaux?schema=public

# Database connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# SQL Query Logging (for debugging)
SQL_ECHO=false

# AWS/S3 Configuration
# In development: S3 is disabled by default; set ENABLE_S3_DEVELOPMENT=true to test
# In staging/production: AWS credentials are required
ENABLE_S3_DEVELOPMENT=false
AWS_ACCESS_KEY=example-access-key
AWS_SECRET_ACCESS_KEY=example-secret-access-key
AWS_REGION=eu-west-2
REPORT_STORAGE_BUCKET=bordereaux-report

# Subscription & API Configuration
DEFAULT_SUBSCRIPTION_TIER=bordereaux
ADMIN_EMAILS=user@axios.global
DEV_API_KEY=example-api-key
