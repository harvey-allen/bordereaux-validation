# Staging Environment Configuration
# Pre-production environment with RDS PostgreSQL and S3 enabled
# Run: ENVIRONMENT=staging docker-compose -f docker-compose.staging.yml up

ENVIRONMENT=staging

# Database: AWS RDS PostgreSQL endpoint
# Replace with actual RDS endpoint from Terraform output
DATABASE_URL=postgresql://postgres:PASSWORD@bordereaux-rds-staging.xxxxx.rds.amazonaws.com:5432/bordereaux?schema=public
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
SQL_ECHO=false

# AWS/S3: Enabled for staging
AWS_ACCESS_KEY=${AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=eu-west-2
REPORT_STORAGE_BUCKET=bordereaux-report-staging

# API & Subscription
DEFAULT_SUBSCRIPTION_TIER=bordereaux
ADMIN_EMAILS=admin@staging.axios.global
DEV_API_KEY=${DEV_API_KEY_STAGING}
