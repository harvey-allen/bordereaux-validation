# Production Environment Configuration
# Production environment with RDS PostgreSQL and S3 fully enabled
# All sensitive values should be injected via AWS Secrets Manager or environment variables
# Run: ENVIRONMENT=production docker run ... (ECS Task Definition)

ENVIRONMENT=production

# Database: AWS RDS PostgreSQL endpoint
# Injected via ECS Task Definition or AWS Secrets Manager
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
SQL_ECHO=false

# AWS/S3: Required for production
# Injected via ECS Task Definition or AWS Secrets Manager
AWS_ACCESS_KEY=${AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=eu-west-2
REPORT_STORAGE_BUCKET=bordereaux-report-production

# API & Subscription
DEFAULT_SUBSCRIPTION_TIER=bordereaux
ADMIN_EMAILS=${ADMIN_EMAILS}
DEV_API_KEY=${DEV_API_KEY_PRODUCTION}
