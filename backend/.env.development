# Development Environment Configuration
# Local development with PostgreSQL on localhost and S3 disabled by default
# Run: ENVIRONMENT=development python -m uvicorn app.main:app --reload

ENVIRONMENT=development

# Database: Local PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bordereaux?schema=public
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SQL_ECHO=false

# AWS/S3: Disabled by default in development
# Set ENABLE_S3_DEVELOPMENT=true to test S3 integration with credentials below
ENABLE_S3_DEVELOPMENT=false
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
REPORT_STORAGE_BUCKET=bordereaux-report-dev

# API & Subscription
DEFAULT_SUBSCRIPTION_TIER=developer
ADMIN_EMAILS=developer@localhost
DEV_API_KEY=dev_bordereaux_key_12345
